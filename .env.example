# Compose host ports
WEB_PORT=4200
API_PORT=8080
MONGO_PORT=27017

# API and MongoDB configuration
ASPNETCORE_ENVIRONMENT=Development
MONGO_DATABASE=flowtrack
MONGO_USERS_COLLECTION=users
MONGO_TASKS_COLLECTION=tasks

# Replace this value for anything beyond local development.
# Use at least 32 UTF-8 bytes.
JWT_SECRET=replace-this-with-a-secure-development-secret-at-least-32-bytes
JWT_ISSUER=FlowTrack.Api
JWT_AUDIENCE=FlowTrack.Client
